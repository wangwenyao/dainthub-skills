{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dainthub.local/skills/award-grade-design/design-spec.json",
  "title": "Award-Grade Design Specification",
  "description": "Design Specification 的唯一机器 Schema。screens[] 的形状与 schemas/page-dsl.schema.json 必须保持一致。",
  "type": "object",
  "required": ["spec_version", "product", "experience", "information_architecture", "art_direction", "system", "screens", "qa"],
  "additionalProperties": false,
  "properties": {
    "spec_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "product": {
      "type": "object",
      "required": ["name", "type", "target_users", "jobs_to_be_done"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "business_context": {"type": "string"},
        "target_users": {"type": "array", "items": {"type": "string"}},
        "jobs_to_be_done": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "experience": {
      "type": "object",
      "required": ["goals", "principles", "anti_goals"],
      "additionalProperties": false,
      "properties": {
        "goals": {"type": "array", "items": {"type": "string"}},
        "principles": {"type": "array", "items": {"type": "string"}},
        "success_metrics": {"type": "array", "items": {"type": "string"}},
        "anti_goals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "information_architecture": {
      "type": "object",
      "required": ["navigation", "hierarchy", "objects", "journeys"],
      "additionalProperties": false,
      "properties": {
        "navigation": {"type": ["string", "object", "array"]},
        "hierarchy": {"type": ["string", "object", "array"]},
        "objects": {"type": "array"},
        "journeys": {"type": "array"}
      }
    },
    "art_direction": {
      "type": "object",
      "required": ["concept", "visual_pillars", "typography", "color", "shape", "surface"],
      "additionalProperties": false,
      "properties": {
        "concept": {"type": "string"},
        "mood": {"type": "string"},
        "visual_pillars": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string"}},
        "typography": {
          "type": "object",
          "properties": {
            "typeface_primary": {"type": "string"},
            "typeface_secondary": {"type": "string"},
            "scale": {"type": ["array", "object"]},
            "line_height": {"type": ["string", "number", "object"]},
            "weights": {"type": ["array", "object"]},
            "cjk_notes": {"type": "string"}
          }
        },
        "color": {
          "type": "object",
          "properties": {
            "strategy": {"type": "string"},
            "roles": {"type": ["array", "object"]},
            "contrast_targets": {"type": ["array", "object"]},
            "dark_mode": {"type": ["string", "object"]}
          }
        },
        "shape": {
          "type": "object",
          "properties": {
            "language": {"type": "string"},
            "radius_scale": {"type": ["array", "object"]}
          }
        },
        "surface": {
          "type": "object",
          "properties": {
            "material": {"type": "string"},
            "elevation": {"type": ["array", "object"]},
            "border_strategy": {"type": "string"}
          }
        },
        "imagery": {
          "type": "object",
          "properties": {
            "direction": {"type": "string"},
            "allowed": {"type": "array", "items": {"type": "string"}},
            "forbidden": {"type": "array", "items": {"type": "string"}}
          }
        },
        "iconography": {
          "type": "object",
          "properties": {
            "set": {"type": "string"},
            "stroke": {"type": ["string", "number"]},
            "sizing": {"type": ["array", "object"]}
          }
        }
      }
    },
    "system": {
      "type": "object",
      "required": ["tokens", "components", "patterns", "density_modes"],
      "additionalProperties": false,
      "properties": {
        "tokens": {"type": "array", "items": {"type": "object"}},
        "components": {"type": "array", "items": {"type": "object"}},
        "patterns": {"type": "array", "items": {"type": "object"}},
        "density_modes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["comfortable", "standard", "compact"]}
        }
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "primary_task", "information_hierarchy", "states", "responsive"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "purpose": {"type": "string"},
          "primary_task": {"type": "string"},
          "archetype": {"type": "string"},
          "primary_action": {"type": "string"},
          "density": {"enum": ["comfortable", "standard", "compact"]},
          "information_hierarchy": {"type": "array", "items": {"type": "string"}},
          "composition": {"type": ["string", "object", "array"]},
          "components": {"type": "array"},
          "states": {"type": "array"},
          "responsive": {"type": ["string", "object", "array"]},
          "motion": {"type": ["string", "object", "array"]},
          "accessibility": {"type": ["string", "object", "array"]},
          "data_viz": {"type": ["string", "object", "array", "null"]}
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reuse": {"type": "array"},
        "configure": {"type": "array"},
        "wrap": {"type": "array"},
        "extend": {"type": "array"},
        "replace": {"type": "array"},
        "create": {"type": "array"},
        "integration_notes": {"type": "array", "items": {"type": "string"}}
      }
    },
    "qa": {
      "type": "object",
      "required": ["viewports", "critical_flows", "acceptance_criteria"],
      "additionalProperties": false,
      "properties": {
        "viewports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["width", "height"],
            "additionalProperties": false,
            "properties": {
              "width": {"type": "integer"},
              "height": {"type": "integer"}
            }
          }
        },
        "critical_flows": {"type": "array"},
        "defect_thresholds": {
          "type": "object",
          "properties": {
            "unresolved_p0": {"type": "integer"},
            "unresolved_p1_critical_flow": {"type": "integer"}
          }
        },
        "acceptance_criteria": {"type": "array"},
        "evidence": {"type": "array"}
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["decision", "reason"],
        "additionalProperties": false,
        "properties": {
          "decision": {"type": "string"},
          "reason": {"type": "string"},
          "impact": {"type": "string"},
          "follow_up": {"type": "string"}
        }
      }
    }
  }
}
