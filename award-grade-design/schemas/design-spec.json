{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/award-grade/design-spec.schema.json",
  "title": "Award-Grade Design Specification",
  "type": "object",
  "required": ["spec_version", "product", "experience", "information_architecture", "art_direction", "system", "screens", "qa"],
  "properties": {
    "spec_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "product": {
      "type": "object",
      "required": ["name", "type", "target_users", "jobs_to_be_done"],
      "properties": {
        "name": {"type": "string"},
        "type": {"type": "string"},
        "business_context": {"type": "string"},
        "target_users": {"type": "array", "items": {"type": "string"}},
        "jobs_to_be_done": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      }
    },
    "experience": {
      "type": "object",
      "required": ["goals", "principles", "anti_goals"],
      "properties": {
        "goals": {"type": "array", "items": {"type": "string"}},
        "principles": {"type": "array", "items": {"type": "string"}},
        "success_metrics": {"type": "array", "items": {"type": "string"}},
        "anti_goals": {"type": "array", "items": {"type": "string"}}
      }
    },
    "information_architecture": {
      "type": "object",
      "required": ["navigation", "hierarchy", "objects", "journeys"],
      "properties": {
        "navigation": {"type": ["string", "object", "array"]},
        "hierarchy": {"type": ["string", "object", "array"]},
        "objects": {"type": "array"},
        "journeys": {"type": "array"}
      }
    },
    "art_direction": {
      "type": "object",
      "required": ["concept", "visual_pillars", "typography", "color", "shape", "surface"],
      "properties": {
        "concept": {"type": "string"},
        "mood": {"type": "string"},
        "visual_pillars": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"type": "string"}},
        "typography": {"type": "object"},
        "color": {"type": "object"},
        "shape": {"type": "object"},
        "surface": {"type": "object"},
        "imagery": {"type": "object"},
        "iconography": {"type": "object"}
      }
    },
    "system": {
      "type": "object",
      "required": ["tokens", "components", "patterns", "density_modes"],
      "properties": {
        "tokens": {"type": "array"},
        "components": {"type": "array"},
        "patterns": {"type": "array"},
        "density_modes": {"type": "array", "minItems": 1}
      }
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "purpose", "primary_task", "information_hierarchy", "states", "responsive"],
        "properties": {
          "id": {"type": "string"},
          "purpose": {"type": "string"},
          "primary_task": {"type": "string"},
          "information_hierarchy": {"type": "array", "items": {"type": "string"}},
          "composition": {"type": ["string", "object", "array"]},
          "components": {"type": "array"},
          "states": {"type": "array"},
          "responsive": {"type": ["string", "object", "array"]},
          "motion": {"type": ["string", "object", "array"]},
          "accessibility": {"type": ["string", "object", "array"]},
          "data_viz": {"type": ["string", "object", "array", "null"]}
        }
      }
    },
    "implementation": {"type": "object"},
    "qa": {
      "type": "object",
      "required": ["viewports", "critical_flows", "acceptance_criteria"],
      "properties": {
        "viewports": {"type": "array"},
        "critical_flows": {"type": "array"},
        "defect_thresholds": {"type": "object"},
        "acceptance_criteria": {"type": "array"},
        "evidence": {"type": "array"}
      }
    },
    "exceptions": {"type": "array"}
  }
}
